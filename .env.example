# Configuration de la caisse. Copiée automatiquement vers .env au premier lancement
# (npm install / npm start). Modifiez .env, jamais ce fichier : .env n'est pas versionné.

# Port HTTP de la caisse (http://localhost:PORT)
PORT=3000
# Adresse d'écoute : 0.0.0.0 = accessible depuis les tablettes et téléphones du réseau local,
# 127.0.0.1 = uniquement depuis cet ordinateur
HOST=0.0.0.0
# Emplacement de la base SQLite (à sauvegarder régulièrement)
DB_PATH=data/caisse.db

# Import depuis caisse.enregistreuse.fr (script npm run import:ce)
# Identifiants visibles dans l'interface de gestion de caisse.enregistreuse.fr
CE_SHOP_ID=
CE_API_KEY=
CE_BASE_URL=https://caisse.enregistreuse.fr
